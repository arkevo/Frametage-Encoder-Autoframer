# ============================================================
# ftea settings
# ============================================================
# Copy this file to config.env and edit the copy; config.env is never
# committed. Without a config.env, ftea uses exactly these defaults.
# config.env lives in the data folder: the repository folder, or the
# folder named by the FTEA_HOME environment variable.
# Format: KEY=value, one per line. Lines starting with # are comments.
# A setting ftea does not know, such as a misspelt key, is named in a
# warning when a run starts.
# Environment variables: any REFRAME* variable set in the environment
# overrides the same key here (REFRAME, REFRAME_TIMEOUT, REFRAME_STRIDE
# and so on); no other setting can be overridden that way. --reframe and
# --no-reframe on the command line override REFRAME from either place.
# ============================================================

# --- Starting CQ for each variant ---
# For every scene and variant, ftea test-encodes at START_CQ - CQ_BRACKET
# and at START_CQ + CQ_BRACKET, scores both with VMAF, and keeps the one
# that meets the target with the fewest bits. Lower CQ = higher quality.
# CQ_BRACKET must be at least 1.
AV1_START_CQ_1080=30
AV1_START_CQ_720=33
AV1_START_CQ_360=38
H264_START_CQ_1080=25
H264_START_CQ_720=28
H264_START_CQ_360=32
CQ_BRACKET=4

# --- NVENC encoder settings ---
# p7 is the slowest, highest-quality preset. h264_nvenc has no "uhq"
# tune, so the H.264 variants use "hq" when NVENC_TUNE=uhq.
NVENC_PRESET=p7
NVENC_TUNE=uhq
NVENC_RC=vbr
NVENC_MULTIPASS=fullres
NVENC_RC_LOOKAHEAD=32

# --- Quality targets (VMAF, 0-100) ---
# Each scene of each variant is encoded to meet its target where the
# probes allow. VMAF_FLOOR is one floor for every variant and is not
# compared with the targets: a clip with any variant whose worst scene
# scores below it is reported with status "warning". With these values
# the 360p target (88) is below the floor (91), so a 360p scene that
# meets its target can still mark the clip "warning". The later retries
# lower the targets (RETRY_VMAF_RELAXATION) but not the floor.
# VMAF_WORKERS is the number of VMAF scorings run in parallel.
VMAF_TARGET_1080=93
VMAF_TARGET_720=93
VMAF_TARGET_360=88
VMAF_FLOOR=91
VMAF_WORKERS=8

# --- Bitrate caps (peak rate), written as <number>k, above 0 ---
# The rate-control buffer is BUFSIZE_MULTIPLIER (at least 1) times the
# cap.
AV1_MAXRATE_1080=3000k
AV1_MAXRATE_720=1500k
AV1_MAXRATE_360=400k
H264_MAXRATE_1080=4000k
H264_MAXRATE_720=2500k
H264_MAXRATE_360=800k
BUFSIZE_MULTIPLIER=2

# --- Bit depth ---
# AV1_BIT_DEPTH is 8 or 10. The H.264 variants are always encoded in
# 8-bit High profile, so H264_BIT_DEPTH must be 8.
AV1_BIT_DEPTH=10
H264_BIT_DEPTH=8

# --- Film grain synthesis (AV1, when the FFmpeg build supports it) ---
# FILM_GRAIN applies to colour clips and FILM_GRAIN_BW to black-and-white
# ones. A clip counts as black-and-white when its average saturation over
# the first 5 seconds is below BW_SATURATION_THRESHOLD. When this FFmpeg's
# av1_nvenc has no film grain option, a run says so at the start and the
# clip reports record grain 0.
FILM_GRAIN=0
FILM_GRAIN_BW=8
BW_SATURATION_THRESHOLD=10

# --- Scene detection ---
# SCENE_THRESHOLD is the cut sensitivity, between 0 and 1; lower finds
# more cuts. Scenes shorter than MIN_SCENE_SEC merge into a neighbour;
# scenes longer than MAX_SCENE_SEC are split evenly. MAX_SCENE_SEC must
# be above 0, and MIN_SCENE_SEC between 0 and MAX_SCENE_SEC.
SCENE_THRESHOLD=0.3
MAX_SCENE_SEC=10
MIN_SCENE_SEC=1.0

# --- HLS ---
# Segment length in seconds. A keyframe starts every segment.
HLS_SEGMENT_SEC=2

# --- Thumbnail (the first frame): webp or jpg ---
THUMB_FORMAT=webp

# --- Audio (AAC, muxed into every variant) ---
AUDIO_BITRATE=128k
AUDIO_SAMPLE_RATE=44100

# --- Batch ---
# BATCH_ON_ERROR: skip = carry on with the next clip; stop = halt.
# CLIP_TIMEOUT and CLIP_TIMEOUT_PER_SEC: the time allowed for encoding
# one clip is CLIP_TIMEOUT + CLIP_TIMEOUT_PER_SEC x the clip's length in
# seconds. On an RTX 5080, encoding took about 6 seconds per second of
# video (11 at worst), so 30 leaves room for slower cards while a hang on
# a short clip is still noticed quickly. A tool still running when the
# time is up is stopped and the clip fails. Reframing has its own
# REFRAME_TIMEOUT. CLIP_TIMEOUT minimum 30.
# MAX_CLIP_SEC: videos longer than this many seconds are skipped. ftea is
# made for short clips, so split a long video first. 0 = no limit.
# MAX_KEPT_FAILURES: work folders of failed clips kept for debugging.
BATCH_ON_ERROR=skip
CLIP_TIMEOUT=300
CLIP_TIMEOUT_PER_SEC=30
MAX_CLIP_SEC=600
MAX_KEPT_FAILURES=5

# --- Retry ---
# A failed clip gets up to RETRY_MAX more attempts, each with
# CLIP_TIMEOUT, CLIP_TIMEOUT_PER_SEC and REFRAME_TIMEOUT multiplied by
# RETRY_TIMEOUT_MULTIPLIER. The first keeps the quality targets, because
# most failures are transient. Later attempts also lower every VMAF
# target by RETRY_VMAF_RELAXATION.
# RETRY_TIMEOUT_MULTIPLIER is at least 1. RETRY_VMAF_RELAXATION runs from
# 0 up to the lowest VMAF target minus 50, so no target drops below 50.
# With BATCH_ON_ERROR=stop there are no retries: the batch halts.
RETRY_MAX=2
RETRY_VMAF_RELAXATION=2
RETRY_TIMEOUT_MULTIPLIER=2

# --- Auto-reframe (landscape to vertical 9:16) ---
# Master switch. A landscape clip is reframed to follow its subjects;
# vertical and square clips skip reframing. A clip that is neither 9:16
# nor 16:9, such as a square one, is then padded with black bars onto
# the 9:16 frame (onto 16:9 instead when it is wider than tall and
# reframing is off). --no-reframe on the command line and the REFRAME
# environment variable both override it (see the top of this file).
# REFRAME and REFRAME_KEEP_CROPS take true or false (yes/no, on/off and
# 1/0 work too); any other value stops the run with an error.
REFRAME=true
# Interpreter of the reframe virtualenv. Empty = .venv-reframe in the
# repository (Scripts/python.exe on Windows, bin/python on Linux). A
# relative path is read from the data folder.
REFRAME_PYTHON=
# Time limit for reframing one clip, in seconds. Separate from
# CLIP_TIMEOUT, which covers encoding only; retries multiply it by
# RETRY_TIMEOUT_MULTIPLIER too. When it runs out, the stage and the
# ffmpeg it started are stopped. Minimum 30.
REFRAME_TIMEOUT=600
# Keep the reframe crop track (crops.json, the crop window for every
# frame) after the clip finishes. Useful when reporting a framing problem.
REFRAME_KEEP_CROPS=true
# Where kept crop tracks go. Empty = the clip's own output folder
# (output/<clip>/crops.json). Otherwise <folder>/<clip>.crops.json.
REFRAME_CROPS_DIR=
# Detection -- read by ftea/reframe/detect.py
# Folder that holds the detector weights. Empty = models/ in the data
# folder, where install.sh puts them.
REFRAME_MODELS_DIR=
REFRAME_PERSON_MODEL=
REFRAME_FACE_MODEL=
REFRAME_STRIDE=3
REFRAME_BATCH_SIZE=16
# Where person detection runs: cuda (the first GPU), cuda:N (another
# GPU), or cpu (much slower). Any other value stops the clip with an error.
REFRAME_DEVICE=cuda
# Detection confidence floors, one per class. They are two different
# detectors on two different scales, so one shared floor does not work:
# person (Faster R-CNN) scores reach 0.9856, while face (YuNet) scores
# never exceeded 0.7462 in testing. A person floor below about 0.8 lets
# lace and curtain textures score around 0.60 and become phantom subjects.
REFRAME_MIN_CONFIDENCE_PERSON=0.8
REFRAME_MIN_CONFIDENCE_FACE=0.35
# Long side, in pixels, of the frame given to the detectors.
# 0 = the native display resolution: the default, and the only setting
# tested for recall. A positive value downscales before detection and
# maps the boxes back, trading face recall for speed. Measured YuNet cost
# per frame: 133.0 ms at 3840, 61.0 at 2560, 31.7 at 1920, 14.8 at 1280.
# Measure recall on your own footage before lowering it.
REFRAME_DETECT_LONG_SIDE=0
# Subject selection -- read by ftea/reframe/subject.py
REFRAME_FACE_WEIGHT=2.0
REFRAME_HYSTERESIS_MARGIN=0.2
REFRAME_HYSTERESIS_SEC=1.0
# All dimensionless fractions, never pixels.
# Largest share of its score a subject may lose for being off-centre
# horizontally. 0 disables centrality. Range [0, 1).
REFRAME_CENTRALITY_WEIGHT=0.5
# Largest share a subject may lose for a detection score at its class
# floor. Kept small: face scores never exceed 0.75. Range [0, 1).
REFRAME_CONFIDENCE_WEIGHT=0.3
# Largest share a track may lose for appearing in few of a shot's
# sampled frames. This is what stops a 2-frame flash winning. [0, 1).
REFRAME_PERSISTENCE_WEIGHT=0.5
# Minimum link affinity for an observation to continue a track. (0, 1].
REFRAME_IOU_MATCH_MIN=0.3
# Seconds a track survives unobserved before it closes. Converted to
# samples with the clip's fps and REFRAME_STRIDE. >= 0.
REFRAME_TRACK_GAP_SEC=0.25
# Camera path -- read by ftea/reframe/camera.py
REFRAME_DEAD_ZONE=0.9
# How close to centred the subject must get before the camera
# disengages and holds again, as a fraction of the dead-zone
# half-width. 0 never disengages and copies post-pan jitter.
REFRAME_DEAD_ZONE_RELEASE=0.6
REFRAME_SMOOTHING_HZ=0.6
REFRAME_MAX_PAN_FRAC_PER_SEC=0.20
# Intermediate render -- read by ftea/reframe/render.py
# Codec: hevc_nvenc, h264_nvenc, av1_nvenc or ffv1. ffv1 is true-lossless
# but cannot be muxed into mp4; pair it with REFRAME_CONTAINER=mkv.
# Container: mp4 or mkv. Preset: p1 (fastest) to p7 (best) for the NVENC
# codecs; ffv1 ignores it. A value outside these stops the clip at once.
REFRAME_ASPECT_W=9
REFRAME_ASPECT_H=16
REFRAME_CODEC=hevc_nvenc
REFRAME_CQ=10
REFRAME_PRESET=p7
REFRAME_CONTAINER=mp4
# Absolute path to the ffmpeg the render uses. Empty resolves "ffmpeg"
# from PATH. ffprobe is found next to it by name, so there is no
# REFRAME_FFPROBE key. Shot detection and the input check always use
# ffmpeg and ffprobe from PATH, as the encoder itself does.
# REFRAME_FFMPEG=
# Shot boundaries -- read by ftea/reframe/shots.py
# Scene-cut sensitivity, in (0, 1]; lower finds more cuts.
REFRAME_SCENE_THRESHOLD=0.3
# Shortest shot kept, in seconds; shorter runs merge into the previous
# shot. Must be >= 0.
REFRAME_MIN_SHOT_SEC=0.4
# Title-aware framing -- read by ftea/reframe/text.py
# Master switch: true or false (yes/no, on/off and 1/0 work too); any
# other value stops the clip with an error. false = text detection never
# runs, and the output is identical to a build without the feature.
REFRAME_TITLE_ENABLED=true
# Text-detection weights (PP-OCRv3, Apache-2.0). Empty = the file
# text_detection_en_ppocrv3_2023may.onnx in the models folder, which
# install.sh downloads.
REFRAME_TITLE_MODEL=
# Long side in px of the frame given to the text detector. Both axes are
# rounded up to a multiple of 32, because the detector is fully
# convolutional with a stride of 32. Title lettering is about 7.4% of the
# frame height, which 640 resolves with margin: in testing it found every
# line of a five-line credit block at 1920x1080 and no false boxes on a
# shot full of street signs and graffiti. Must be >= 320.
REFRAME_TITLE_LONG_SIDE=640
# Frames sampled per shot. One shot can hold more than one title card,
# so sampling only its first frame is not enough. Must be >= 1.
REFRAME_TITLE_PROBE_FRAMES=5
# Minimum height of a text line, as a fraction of the frame height, for
# it to count as a title line. At 1080 this is 43.2 px, which keeps
# 84-98 px credit lines and rejects a stray 20 px box beside them.
REFRAME_TITLE_MIN_HEIGHT=0.04
# Minimum number of aligned lines. One line is not a title card.
REFRAME_TITLE_MIN_LINES=2
# How far the line centres may spread, as a fraction of the frame width,
# and still count as sharing one centre. A centred five-line credit block
# spans about 8 px at 1920 (0.004); scattered text does not line up.
REFRAME_TITLE_CENTRE_TOL=0.05
# Maximum tilt of a text box from horizontal, in degrees. Only
# axis-aligned text counts; a rotated sign is not a title card.
REFRAME_TITLE_MAX_SKEW=10.0
# Clear space required on each side of centred text, as a fraction of
# the frame width, before the shot letterboxes instead. It stops a title
# that only just fits from touching both crop edges. A judgement call,
# not a measurement.
REFRAME_TITLE_EDGE_MARGIN=0.01
